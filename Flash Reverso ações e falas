	end
end

local function iniciarCooldown()
	ocupado = true
	atualizarBotoes()
	task.spawn(function()
		local fim = os.clock() + INTERVALO
		while true do
			local resto = fim - os.clock()
			if resto <= 0 then
				break
			end
			setStatus(string.format("⏳ Aguarde %.1fs para enviar outra mensagem", resto), false)
			task.wait(0.1)
		end
		ocupado = false
		atualizarBotoes()
		setStatus("✅ Pronto para enviar", false)
	end)
end

-- Retorna true se a mensagem foi enviada
local function enviar(mensagem, efeito)
	if ocupado then
		setStatus("⏳ Aguarde o intervalo de " .. INTERVALO .. " segundos", true)
		return false
	end
	ocupado = true -- bloqueia já (evita toque duplo enquanto o envio acontece)
	local ok, err = enviarNoChat(mensagem)
	if not ok then
		ocupado = false
		atualizarBotoes()
		setStatus("❌ Falha ao enviar: " .. tostring(err), true)
		return false
	end
	tocarEfeito(efeito)
	iniciarCooldown()
	return true
end

local function tratarItem(item)
	if ocupado then
		setStatus("⏳ Aguarde o intervalo de " .. INTERVALO .. " segundos", true)
		return
	end
	local mensagem = item.texto
	if item.precisaNome then
		local nome = limpar(caixaNome.Text)
		if nome == "" then
			setStatus("⚠️ Digite o nome do personagem", true)
			return
		end
		mensagem = (string.gsub(item.texto, PLACEHOLDER_NOME, function()
			return nome
		end))
	end
	if tamanhoTexto(mensagem) > LIMITE_CHAT then
		setStatus("⚠️ Mensagem muito longa (máx. " .. LIMITE_CHAT .. " caracteres)", true)
		return
	end
	enviar(mensagem, item.efeito)
end

