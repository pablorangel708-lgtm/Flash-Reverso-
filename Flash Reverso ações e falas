local function emitirParticulas(raiz, quantidade)
	local emissor = novo("ParticleEmitter", {
		Color = ColorSequence.new(COR_RAIO),
		LightEmission = 1,
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.6),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.3, 0.6),
		Speed = NumberRange.new(12, 25),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 3,
		Rate = 0,
	}, raiz)
	emissor:Emit(quantidade)
	Debris:AddItem(emissor, 1.2)
end

local function criarRaio(centro)
	local dir = Vector3.new(math.random() * 2 - 1, math.random() * 1.4 - 0.4, math.random() * 2 - 1)
	if dir.Magnitude < 0.1 then
		dir = Vector3.yAxis
	end
	dir = dir.Unit
	local pontoAtual = centro + dir * 1.5
	for i = 1, 4 do
		local alvo = centro
			+ dir * (1.5 + i * 1.3)
			+ Vector3.new(math.random() * 1.4 - 0.7, math.random() * 1.4 - 0.7, math.random() * 1.4 - 0.7)
		local comprimento = (alvo - pontoAtual).Magnitude
		if comprimento > 0.05 then
			local parte = novo("Part", {
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Material = Enum.Material.Neon,
				Color = COR_RAIO,
				Size = Vector3.new(0.15, 0.15, comprimento),
				CFrame = CFrame.lookAt(pontoAtual, alvo) * CFrame.new(0, 0, -comprimento / 2),
			}, pastaFX)
			TweenService:Create(parte, TweenInfo.new(0.35), { Transparency = 1 }):Play()
			Debris:AddItem(parte, 0.5)
		end
		pontoAtual = alvo
	end
end

local function ligarTrail(raiz, duracao)
	local a0 = novo("Attachment", { Position = Vector3.new(0, 1.5, 0) }, raiz)
	local a1 = novo("Attachment", { Position = Vector3.new(0, -1.5, 0) }, raiz)
	local trail = novo("Trail", {
		Attachment0 = a0,
		Attachment1 = a1,
		Color = ColorSequence.new(Color3.fromRGB(255, 20, 20), Color3.fromRGB(120, 0, 0)),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = 0.5,
		LightEmission = 1,
		MinLength = 0.05,
		FaceCamera = true,
	}, raiz)
	task.delay(duracao, function()
		trail.Enabled = false
		Debris:AddItem(trail, 1)
		Debris:AddItem(a0, 1)
		Debris:AddItem(a1, 1)
	end)
end

local function criarFantasma(personagem, deslocamento)
	for _, p in ipairs(personagem:GetChildren()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Transparency < 1 then
			local g = novo("Part", {
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Material = Enum.Material.Neon,
				Color = Color3.fromRGB(200, 0, 0),
				Transparency = 0.55,
				Size = p.Size,
				CFrame = p.CFrame + deslocamento,
			}, pastaFX)
			TweenService:Create(g, TweenInfo.new(0.6), { Transparency = 1 }):Play()
			Debris:AddItem(g, 0.8)
		end
	end
end

local function tocarEfeito(nome)
	if not efeitosAtivos or not nome then
		return
	end
	local cfg = EFEITOS[nome]
	if not cfg then
		return
	end
	local personagem = player.Character
	local raiz = personagem and personagem:FindFirstChild("HumanoidRootPart")
	if not raiz then
		return
	end

	task.spawn(function()
		if cfg.flash then
			flashTela(cfg.flash)
		end
		if cfg.particulas then
			emitirParticulas(raiz, cfg.particulas)
		end
		if cfg.trail then
			ligarTrail(raiz, cfg.trail)
		end
		if cfg.raios then
			for i = 1, cfg.raios do
				if not raiz.Parent then
					break
				end
				criarRaio(raiz.Position)
				if i % 2 == 0 then
					task.wait(0.04)
				end
			end
		end
		if cfg.fantasmas and cfg.fantasmas > 0 then
			for i = 1, cfg.fantasmas do
				if not personagem.Parent or not raiz.Parent then
					break
				end
				local deslocamento = Vector3.zero
				if cfg.modo == "lados" then
					local lado = (i % 2 == 0) and 1 or -1
					deslocamento = raiz.CFrame.RightVector * lado * (cfg.afastamento or 2) * math.ceil(i / 2)
				end
				criarFantasma(personagem, deslocamento)
				task.wait(0.12)
			end
		end
	end)
end

