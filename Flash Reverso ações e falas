local function enviarNoChat(mensagem)
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local canais = TextChatService:FindFirstChild("TextChannels") or TextChatService:WaitForChild("TextChannels", 3)
		local canal = canais and (canais:FindFirstChild("RBXGeneral") or canais:WaitForChild("RBXGeneral", 3))
		if not canal then
			return false, "canal RBXGeneral não encontrado"
		end
		local ok, err = pcall(function()
			canal:SendAsync(mensagem)
		end)
		return ok, err
	else
		local eventos = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			or ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 3)
		local dizer = eventos and (eventos:FindFirstChild("SayMessageRequest") or eventos:WaitForChild("SayMessageRequest", 3))
		if not dizer then
			return false, "chat legado não encontrado"
		end
		local ok, err = pcall(function()
			dizer:FireServer(mensagem, "All")
		end)
		return ok, err
	end
end

