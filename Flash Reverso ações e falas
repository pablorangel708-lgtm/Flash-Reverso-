local function criarBotaoLista(textoBotao, aoClicar)
	local b = novo("TextButton", {
		Size = UDim2.new(1, 0, 0, 34),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = ocupado and COR_BOTAO_OCUPADO or COR_BOTAO,
		Text = textoBotao,
		TextColor3 = BRANCO,
		TextSize = 14,
		Font = Enum.Font.GothamMedium,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTransparency = ocupado and 0.55 or 0,
		LayoutOrder = proximaOrdem(),
	}, lista)
	novo("UICorner", { CornerRadius = UDim.new(0, 8) }, b)
	novo("UIStroke", { Color = VERMELHO_ESCURO, Thickness = 1 }, b)
	novo("UIPadding", {
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		PaddingTop = UDim.new(0, 7),
		PaddingBottom = UDim.new(0, 7),
	}, b)
	b.Activated:Connect(aoClicar)
	table.insert(botoesEnvio, b)
	return b
end

local function limparLista()
	for _, c in ipairs(lista:GetChildren()) do
		if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
	botoesEnvio = {}
	ordem = 0
	lista.CanvasPosition = Vector2.zero
end

local function montarCustom()
	local caixa = novo("TextBox", {
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundColor3 = PRETO_CLARO,
		Text = "",
		PlaceholderText = "Digite sua fala...",
		PlaceholderColor3 = Color3.fromRGB(130, 130, 130),
		TextColor3 = BRANCO,
		Font = Enum.Font.Gotham,
		TextSize = 14,
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = proximaOrdem(),
	}, lista)
	novo("UICorner", { CornerRadius = UDim.new(0, 8) }, caixa)
	novo("UIStroke", { Color = VERMELHO_ESCURO, Thickness = 1 }, caixa)
	novo("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, caixa)

	local enviarBtn = criarBotaoLista("ENVIAR", function()
		if ocupado then
			setStatus("⏳ Aguarde o intervalo de " .. INTERVALO .. " segundos", true)
			return
		end
		local fala = limpar(caixa.Text)
		if fala == "" then
			setStatus("⚠️ Digite uma fala antes de enviar", true)
			return
		end
		local mensagem = PREFIXO .. fala
		if tamanhoTexto(mensagem) > LIMITE_CHAT then
			setStatus("⚠️ Fala muito longa (máx. " .. (LIMITE_CHAT - tamanhoTexto(PREFIXO)) .. " caracteres)", true)
			return
		end
		if enviar(mensagem, nil) then
			caixa.Text = ""
		end
	end)
	enviarBtn.TextXAlignment = Enum.TextXAlignment.Center
	enviarBtn.Font = Enum.Font.GothamBlack
	enviarBtn.TextColor3 = VERMELHO
end

local botoesAbas = {}

local function mostrarCategoria(indice)
	local cat = CATEGORIAS[indice]
	limparLista()
	for i, b in ipairs(botoesAbas) do
		b.BackgroundColor3 = (i == indice) and VERMELHO or VERMELHO_ESCURO
	end
	if cat.tipo == "custom" then
		montarCustom()
	else
		for _, item in ipairs(cat.itens) do
			local rotulo = item.titulo
			if item.precisaNome and cat.nome ~= "Falas" then
				rotulo = rotulo .. "  👤"
			end
			criarBotaoLista(rotulo, function()
				tratarItem(item)
			end)
		end
	end
end

for i, cat in ipairs(CATEGORIAS) do
	local aba = novo("TextButton", {
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = VERMELHO_ESCURO,
		Text = cat.nome,
		TextColor3 = BRANCO,
		TextSize = 13,
