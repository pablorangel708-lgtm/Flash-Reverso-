--------------------------------------------------------------------
-- BOTÃO ⚡ ARRASTÁVEL (toque curto = abrir/fechar)
--------------------------------------------------------------------
local arrastando = false
local moveu = false
local inputAtivo = nil
local inicioInput = Vector2.zero
local inicioPos = Vector2.zero

botao.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		arrastando = true
		moveu = false
		inputAtivo = input
		inicioInput = Vector2.new(input.Position.X, input.Position.Y)
		inicioPos = botao.AbsolutePosition
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				local estavaArrastando = arrastando
				arrastando = false
				inputAtivo = nil
				if estavaArrastando and not moveu then
					painel.Visible = not painel.Visible
				end
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not arrastando then
		return
	end
	local valido = (input == inputAtivo) or (input.UserInputType == Enum.UserInputType.MouseMovement)
	if not valido then
		return
	end
	local delta = Vector2.new(input.Position.X, input.Position.Y) - inicioInput
	if delta.Magnitude > 8 then
		moveu = true
	end
	if moveu then
		local tela = gui.AbsoluteSize
		local x = math.clamp(inicioPos.X + delta.X, 0, math.max(0, tela.X - botao.AbsoluteSize.X))
		local y = math.clamp(inicioPos.Y + delta.Y, 0, math.max(0, tela.Y - botao.AbsoluteSize.Y))
		botao.Position = UDim2.fromOffset(x, y)
	end
end)
